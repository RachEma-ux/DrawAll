# Copy to freellmapi.env (gitignored) and fill in. NEVER commit real keys.
# Root of your FreeLLMAPI server (Claude Code appends /v1/messages itself):
ANTHROPIC_BASE_URL=http://localhost:3001
# Unified key from the FreeLLMAPI dashboard (Keys page). MUST be AUTH_TOKEN, not API_KEY:
# Claude Code refuses to start if ANTHROPIC_API_KEY is also set.
ANTHROPIC_AUTH_TOKEN=freellmapi-REPLACE-ME
# Optional: pin a model family mapping on the dashboard Keys -> Anthropic tab.
